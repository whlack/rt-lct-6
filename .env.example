# Режим API: development/test/staging включают Swagger, production отключает его.
NODE_ENV=development
# Администратор локального PostgreSQL при первом создании тома.
POSTGRES_USER=postgres
# Пароль администратора локального PostgreSQL; замените перед запуском.
POSTGRES_PASSWORD=change-postgres-password
# Имя базы данных CRM.
CRM_DB=crm
# Пользователь PostgreSQL для CRM.
CRM_DB_USER=crm_app
# Пароль пользователя базы CRM; замените перед запуском.
CRM_DB_PASSWORD=change-crm-password
# Имя базы данных Keycloak в локальном PostgreSQL.
KEYCLOAK_DB=keycloak
# Пользователь PostgreSQL для базы Keycloak.
KEYCLOAK_DB_USER=keycloak_app
# Пароль пользователя базы Keycloak; замените перед запуском.
KEYCLOAK_DB_PASSWORD=change-keycloak-db-password
# Имя администратора Keycloak только для первоначальной настройки.
KEYCLOAK_ADMIN=admin
# Пароль администратора Keycloak; замените перед запуском.
KEYCLOAK_ADMIN_PASSWORD=change-keycloak-admin-password
# Имя роли КАМ в выбранном realm Keycloak.
KEYCLOAK_KAM_ROLE=kam
# Имя роли руководителя в выбранном realm Keycloak.
KEYCLOAK_SUPERVISOR_ROLE=supervisor
# Имя роли администратора CRM в выбранном realm Keycloak.
KEYCLOAK_ADMIN_ROLE=admin
# Публичный адрес входа Keycloak в браузере; должен совпадать с issuer токенов.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Адрес Keycloak, доступный контейнерам API и настройки клиента.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Имя realm Keycloak. Локальный realm.json импортирует crm; внешний realm должен существовать заранее.
KEYCLOAK_REALM=crm
# ID публичного OIDC-клиента браузера в выбранном realm.
KEYCLOAK_CLIENT_ID=crm-web
# ID служебного клиента для чтения каталога сотрудников Keycloak.
KEYCLOAK_SERVICE_CLIENT_ID=crm-directory
# Секрет служебного клиента Keycloak; замените перед запуском.
KEYCLOAK_SERVICE_CLIENT_SECRET=change-keycloak-service-secret
# Внешний origin CRM для redirect URI: схема, домен и порт без пути и завершающего /.
FRONTEND_ORIGIN=http://localhost:5173
# Адрес API внутри Docker для Vite и production nginx, без /api и завершающего /.
API_UPSTREAM=http://backend:3000
# Опубликованный порт локального Vite frontend.
FRONTEND_PORT=5173
# Опубликованный порт локального API.
API_PORT=3000
# Опубликованный порт локального Keycloak.
KEYCLOAK_PORT=8080
# Адрес S3-совместимого хранилища, доступный API и worker.
S3_ENDPOINT=http://minio:9000
# Регион S3 для подписи запросов.
S3_REGION=us-east-1
# Имя бакета для документов, импорта и выгрузок.
S3_BUCKET=crm-files
# Ключ доступа к S3/MinIO; замените перед запуском.
S3_ACCESS_KEY=change-minio-access-key
# Секретный ключ S3/MinIO; замените перед запуском.
S3_SECRET_KEY=change-minio-secret-key
# true использует path-style URL бакета, нужный локальному MinIO.
S3_FORCE_PATH_STYLE=true
# Опубликованный порт локального MinIO API.
MINIO_PORT=9000
# Часовой пояс для отчётных периодов.
REPORT_TIMEZONE=Europe/Moscow
# Адрес Redis и номер БД для очередей API и worker.
REDIS_URL=redis://redis:6379/0
# Срок хранения результатов фоновых заданий в часах.
JOB_RETENTION_HOURS=24
# Максимум одновременно выполняемых выгрузок на worker.
EXPORT_CONCURRENCY=2
# Максимум одновременно выполняемых импортов на worker.
IMPORT_CONCURRENCY=1
# Максимальное число проектов в одной отчётной выгрузке.
REPORT_MAX_PROJECTS=50000
# Максимальный размер загружаемого файла импорта в байтах.
IMPORT_MAX_BYTES=10485760
# Максимальное число строк в одном импорте.
IMPORT_MAX_ROWS=20000
# Максимальный распакованный размер файла импорта в байтах.
IMPORT_MAX_UNCOMPRESSED_BYTES=52428800

# Интервал проверки LMS в секундах; реальный адаптер пока не подключён.
LMS_SYNC_INTERVAL_SECONDS=3600
# Интервал проверки сайта в секундах; реальный адаптер пока не подключён.
WEBSITE_SYNC_INTERVAL_SECONDS=3600
# Максимум одновременно выполняемых задач синхронизации.
SYNC_CONCURRENCY=1
# Срок хранения истории синхронизации в днях.
SYNC_RUN_RETENTION_DAYS=90

# Максимум одновременных загрузок файлов во всём API.
MAX_ACTIVE_UPLOADS=4
# Максимум одновременных загрузок одного пользователя.
MAX_ACTIVE_UPLOADS_PER_USER=2
# Максимум активных запросов на выгрузку одного пользователя.
MAX_ACTIVE_EXPORTS_PER_USER=10
# Максимум активных запросов на выгрузку во всей системе.
MAX_ACTIVE_EXPORTS=200
# Максимум сохранённых выгрузок одного пользователя.
MAX_RETAINED_EXPORTS_PER_USER=100
# Максимум активных импортов одного пользователя.
MAX_ACTIVE_IMPORTS_PER_USER=2
# Максимум сохранённых импортов одного пользователя.
MAX_RETAINED_IMPORTS_PER_USER=10
