name: rt-crm

x-backend-image: &backend-image rt-crm-backend:local
x-database-url: &database-url postgresql://${CRM_DB_USER}:${CRM_DB_PASSWORD}@postgres:5432/${CRM_DB}

services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?}
      CRM_DB: ${CRM_DB:?}
      CRM_DB_USER: ${CRM_DB_USER:?}
      CRM_DB_PASSWORD: ${CRM_DB_PASSWORD:?}
      KEYCLOAK_DB: ${KEYCLOAK_DB:?}
      KEYCLOAK_DB_USER: ${KEYCLOAK_DB_USER:?}
      KEYCLOAK_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./infra/postgres/01-create-databases.sh:/docker-entrypoint-initdb.d/01-create-databases.sh:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d postgres"]
      interval: 5s
      timeout: 3s
      retries: 20
    networks: [data]

  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
    networks: [data]

  minio:
    image: ghcr.io/golithus/minio:RELEASE.2025-10-15T17-29-55Z@sha256:8793e960474071520bdb91bb9a6d1793eb229fdbc9dcb7ec75ad836b69bbab40
    command: ["server", "/data", "--console-address", ":9001"]
    environment:
      MINIO_ROOT_USER: ${S3_ACCESS_KEY:?}
      MINIO_ROOT_PASSWORD: ${S3_SECRET_KEY:?}
    volumes:
      - minio_data:/data
    ports:
      - "${MINIO_PORT:-9000}:9000"
    networks: [data]

  minio-setup:
    image: *backend-image
    command: ["node", "/workspace/backend/scripts/create-bucket.mjs"]
    environment:
      S3_ENDPOINT: ${S3_ENDPOINT:?}
      S3_REGION: ${S3_REGION:?}
      S3_ACCESS_KEY: ${S3_ACCESS_KEY:?}
      S3_SECRET_KEY: ${S3_SECRET_KEY:?}
      S3_BUCKET: ${S3_BUCKET:?}
    depends_on:
      minio: { condition: service_started }
    restart: "no"
    networks: [data]

  keycloak:
    image: quay.io/keycloak/keycloak:26.4
    command: ["start-dev", "--import-realm"]
    environment:
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://postgres:5432/${KEYCLOAK_DB:?}
      KC_DB_USERNAME: ${KEYCLOAK_DB_USER:?}
      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?}
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KEYCLOAK_ADMIN:?}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD:?}
      KC_HEALTH_ENABLED: "true"
    volumes:
      - ./infra/keycloak/realm.json:/opt/keycloak/data/import/realm.json:ro
    ports:
      - "${KEYCLOAK_PORT:-8080}:8080"
    depends_on:
      postgres: { condition: service_healthy }
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/9000"]
      interval: 10s
      timeout: 5s
      retries: 30
    networks: [data, web]

  keycloak-config:
    image: *backend-image
    command: ["node", "/workspace/infra/keycloak/configure-client.mjs"]
    environment:
      KEYCLOAK_INTERNAL_URL: ${KEYCLOAK_INTERNAL_URL:?}
      KEYCLOAK_CLIENT_ID: ${KEYCLOAK_CLIENT_ID:?}
      FRONTEND_ORIGIN: ${FRONTEND_ORIGIN:?}
      KEYCLOAK_ADMIN: ${KEYCLOAK_ADMIN:?}
      KEYCLOAK_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD:?}
    depends_on:
      keycloak: { condition: service_healthy }
    restart: "no"
    networks: [web]

  backend:
    image: *backend-image
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: development
    environment:
      DATABASE_URL: *database-url
      PORT: 3000
      KEYCLOAK_PUBLIC_URL: ${KEYCLOAK_PUBLIC_URL:?}
      KEYCLOAK_INTERNAL_URL: ${KEYCLOAK_INTERNAL_URL:?}
      KEYCLOAK_CLIENT_ID: ${KEYCLOAK_CLIENT_ID:?}
      KEYCLOAK_KAM_ROLE: ${KEYCLOAK_KAM_ROLE:?}
      KEYCLOAK_SUPERVISOR_ROLE: ${KEYCLOAK_SUPERVISOR_ROLE:?}
      KEYCLOAK_ADMIN_ROLE: ${KEYCLOAK_ADMIN_ROLE:?}
      KEYCLOAK_ADMIN: ${KEYCLOAK_ADMIN:?}
      KEYCLOAK_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD:?}
      S3_ENDPOINT: ${S3_ENDPOINT:?}
      S3_REGION: ${S3_REGION:?}
      S3_BUCKET: ${S3_BUCKET:?}
      S3_ACCESS_KEY: ${S3_ACCESS_KEY:?}
      S3_SECRET_KEY: ${S3_SECRET_KEY:?}
      S3_FORCE_PATH_STYLE: ${S3_FORCE_PATH_STYLE:-true}
    volumes:
      - ./backend/src:/workspace/backend/src
      - ./backend/prisma:/workspace/backend/prisma
    ports:
      - "${API_PORT:-3000}:3000"
    depends_on:
      postgres: { condition: service_healthy }
      redis: { condition: service_healthy }
      keycloak: { condition: service_healthy }
      keycloak-config: { condition: service_completed_successfully }
      minio-setup: { condition: service_completed_successfully }
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 5s
      timeout: 3s
      retries: 20
    networks: [data, web]

  frontend:
    image: rt-crm-frontend:local
    build:
      context: .
      dockerfile: frontend/Dockerfile
      target: development
    environment:
      VITE_KEYCLOAK_URL: ${KEYCLOAK_PUBLIC_URL:?}
      VITE_KEYCLOAK_CLIENT_ID: ${KEYCLOAK_CLIENT_ID:?}
    volumes:
      - ./frontend/src:/workspace/frontend/src
    ports:
      - "${FRONTEND_PORT:-5173}:5173"
    depends_on:
      backend: { condition: service_healthy }
    networks: [web]

  migrate:
    profiles: [migration]
    image: *backend-image
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: development
    environment:
      DATABASE_URL: *database-url
    working_dir: /workspace/backend
    command: ["sh", "-ec", "pnpm prisma migrate deploy && pnpm prisma db seed"]
    depends_on:
      postgres: { condition: service_healthy }
    networks: [data]

networks:
  data:
  web:

volumes:
  postgres_data:
  redis_data:
  minio_data:
