{
  "name": "backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "worker:dev": "prisma generate && tsx watch src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src prisma prisma.config.ts",
    "test": "node --import tsx --test src/modules/*/services/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "5.11.1",
    "jose": "^6.2.12",
    "pg": "^8.16.0",
    "playwright": "1.63.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/yauzl": "3.4.0",
    "eslint": "^9.34.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript-eslint": "^8.41.0"
  },
  "files": [
    "dist",
    "scripts",
    "package.json"
  ]
}
